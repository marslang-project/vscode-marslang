takepkg std.math;
takepkg std.Decorator;
takepkg std.Error;

// a comment
/* a block
   comment */

fixed hot pi (float) = 3.14159;

family Circle{
    func init(float r){
        me.r = r;
    }

    @Decorator.private
    func squared(){
        ret me.r * me.r;
    }

    func size(){
        ret pi * me.squared();
    }
}

@Decorator.docstring("""
    A label for a name.
    It mentions func and family, which stay part of the string.
""")
func label(string name) => "a family of func in a string";

func m{
    counts (array[int]) = arr(42, 7);
    c = Circle(2.0);
    run {
        out(c.size());
        out(counts.iget(0));
        out(label("x"));
    } handle(Error.TypeError e){
        out(e);
    } then {
        slout("done");
    }
}
